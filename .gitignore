# ───────────────────────────────────────────────
# Mouse Dynamics Authentication — .gitignore
# ───────────────────────────────────────────────

# ── Collected data (user session CSVs) ──────────
data/

# ── User registry (hashed passwords + session state) ──
users.json

# ── Trained models ──────────────────────────────
*.pkl
*.joblib
models/
model/*.pkl
model/*.joblib

# ── Training results & generated plots ──────────
results/

# ── Python cache ────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ── Virtual environments ─────────────────────────
venv/
.venv/
env/
ENV/

# ── Distribution / packaging ─────────────────────
dist/
build/
*.egg-info/
*.egg
.eggs/

# ── Jupyter / IPython ────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── IDE & editor artifacts ───────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Logs ─────────────────────────────────────────
*.log
logs/

# ── Coverage / testing ───────────────────────────
.coverage
htmlcov/
.pytest_cache/
